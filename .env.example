# Copy to .env and fill in. NEVER commit .env. Real secrets belong in
# AWS Secrets Manager / GitHub Secrets, not in this file.

# --- MLflow / DagsHub ---
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# --- DVC remotes (prefer `dvc remote modify --local`) ---
DVC_S3_BUCKET=s3://<bucket>/dvc

# --- AWS (local dev only; CI uses GitHub OIDC) ---
AWS_REGION=<region>
AWS_PROFILE=<profile>

# --- API ---
# Required, 16+ characters. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-value
LOG_LEVEL=INFO
# MODEL_URI loads from the MLflow registry instead of the mounted ./models files (needs mlflow in the image):
# MODEL_URI=models:/credit-risk-default-model@champion

# --- Postgres (docker compose) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=mlflow

# --- Grafana (docker compose) ---
GRAFANA_ADMIN_PASSWORD=change-me-as-well
