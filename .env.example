# Copy to .env and fill in. NEVER commit .env. Real secrets belong in
# AWS Secrets Manager / GitHub Secrets, not in this file.

# --- MLflow / DagsHub ---
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# --- DVC remotes (prefer `dvc remote modify --local`) ---
DVC_S3_BUCKET=s3://<bucket>/dvc

# --- AWS (local dev only; CI uses GitHub OIDC) ---
AWS_REGION=<region>
AWS_PROFILE=<profile>

# --- API ---
API_KEY=change-me
MODEL_URI=models:/credit-risk-default@champion
LOG_LEVEL=INFO

# --- Postgres (docker compose) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow
