# syntax=docker/dockerfile:1
# Drift monitor: reads the API's prediction log, compares it with the training reference and exposes
# /metrics (Prometheus), /status (the retrain DAG's sensor) and /report (the Evidently HTML report).
# Non-root, no secrets, no data inside: the reference data and schema are mounted at run time.

FROM python:3.11-slim-bookworm AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /build
COPY requirements.lock.txt requirements-monitor.txt ./
RUN pip install -c requirements.lock.txt -r requirements-monitor.txt \
 && pip uninstall -y setuptools wheel


FROM python:3.11-slim-bookworm AS runtime
LABEL org.opencontainers.image.title="credit-risk-monitor" \
      org.opencontainers.image.description="Drift and data-quality monitor for the scoring API (coursework)"
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MONITOR_PORT=9101 \
    MONITOR_OUT_DIR=/app/state/monitoring
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app \
 && /usr/local/bin/python -m pip uninstall -y setuptools wheel
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY src/__init__.py ./src/__init__.py
COPY src/monitoring ./src/monitoring
COPY params.yaml ./
RUN mkdir -p /app/state /app/data/reference /app/reports && chown -R app:app /app
USER app
EXPOSE 9101
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9101/status', timeout=4).status == 200 else 1)"]
CMD ["python", "-m", "src.monitoring.drift", "serve"]
